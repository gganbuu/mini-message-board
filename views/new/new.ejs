<form class="add-message-form" action="/new" method="post">
    <%- include("../errors/errors.ejs") %>
    
    <label for="username" class="name-label">name
        <input type="text" 
               id="username" 
               name="username" 
               placeholder="username"
               value="<%= locals.data ? data.username : '' %>"
               required/>
    </label>

    <label for="message" class="message-label">message
        <textarea id="message" 
                  name="message" 
                  placeholder="message" 
                  required><%= locals.data ? data.message : '' %></textarea>
    </label>
    <button>Add message</button>
</form>